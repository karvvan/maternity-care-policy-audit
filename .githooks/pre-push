#!/bin/sh
# 협업 사고 방지용 pre-push 훅.
#   1) main 직접 push 차단
#   2) 원격 커밋을 지우는 force push 차단
#   3) 담당 폴더 밖의 변경 차단
#
# 사용하려면 클론 후 한 번만:  git config core.hooksPath .githooks
# 리포 소유자는 설정하지 않습니다 (소유자는 모든 폴더를 씁니다).

ALLOW='무진님 업데이트/'
ZERO='0000000000000000000000000000000000000000'
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
	# 브랜치 삭제는 검사 대상 아님
	[ "$local_sha" = "$ZERO" ] && continue

	case "$remote_ref" in
	refs/heads/main | refs/heads/master)
		echo "" >&2
		echo "[거부] main 브랜치에 직접 push 할 수 없습니다." >&2
		echo "       자기 브랜치를 만들어 PR로 올려주세요:" >&2
		echo "         git checkout -b mujin/작업이름" >&2
		echo "         git push -u origin mujin/작업이름" >&2
		fail=1
		continue
		;;
	esac

	# force push (원격 커밋이 사라지는 경우) 차단
	if [ "$remote_sha" != "$ZERO" ]; then
		if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
			echo "" >&2
			echo "[거부] 원격에 있는 커밋이 사라지는 push 입니다 (force push)." >&2
			echo "       git pull --rebase 로 먼저 원격 내용을 받아주세요." >&2
			fail=1
			continue
		fi
	fi

	# 담당 폴더 밖 변경 차단
	base=$(git merge-base "$local_sha" origin/main 2>/dev/null)
	[ -z "$base" ] && base=$(git rev-parse origin/main 2>/dev/null)
	[ -z "$base" ] && continue

	outside=$(git diff --name-only "$base" "$local_sha" -- . ":(exclude)$ALLOW" 2>/dev/null)
	if [ -n "$outside" ]; then
		echo "" >&2
		echo "[거부] '$ALLOW' 폴더 밖의 파일이 변경되었습니다:" >&2
		echo "$outside" | sed 's/^/         - /' >&2
		echo "       이 폴더 밖은 읽기 전용입니다. 수정이 필요하면 팀에 먼저 알려주세요." >&2
		fail=1
	fi
done

exit $fail
